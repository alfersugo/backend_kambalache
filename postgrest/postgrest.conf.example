db-uri = "postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/kambalache"
db-schemas = "auth,public,graphql"
db-extra-search-path = "public,graphql,auth"
# Asegurar que la tabla auth.users esté expuesta
# Si existe una línea db-schemas o db-schema, debe incluir 'auth'
# Si hay restricciones adicionales, agregar aquí:
# (No se requieren restricciones adicionales para exponer auth.users si el rol tiene GRANT SELECT)
db-anon-role = "svc_postgrest_user"
server-port = 3000
server-host = "127.0.0.1"
jwt-secret = "<JWT_SECRET_BASE64>"
db-use-legacy-gucs = false
jwt-secret-is-base64 = true
