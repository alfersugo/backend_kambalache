[Unit]
Description=SMTP POSIX AGE API Continuity Validation (test_age_api_continuity.sh)
Documentation=file:///home/zomitech/smtp-posix/docs/features/apache_age_graph_implementation_guide.md
After=postgresql.service postgrest.service mail-worker.service
Wants=postgresql.service postgrest.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/sysconfig/smtp-posix
Environment=SMTP_POSIX_ROOT=/home/zomitech/smtp-posix
# Override with env vars from sysconfig; API_BASE_URL defaults to http://localhost:3000
ExecStart=/usr/bin/bash -lc '"${SMTP_POSIX_ROOT}/backend/scripts/validate/test_age_api_continuity.sh"'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smtp-posix-age-api-continuity
# Allow up to 3 minutes; most runs finish in <60s
TimeoutStartSec=180
# Exit code 2 = AGE not installed (skip); treat as success to avoid alert spam
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
