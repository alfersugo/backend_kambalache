[Unit]
Description=Run SMTP POSIX AGE API continuity validation every 12 hours and after boot

[Timer]
# First run: 12 minutes after boot (after postgrest and mail-worker are ready)
OnBootSec=12min
# Repeat: twice daily — covers morning and evening health check windows
OnUnitActiveSec=12h
# Run missed executions on next boot
Persistent=true
Unit=smtp-posix-age-api-continuity.service

[Install]
WantedBy=timers.target
